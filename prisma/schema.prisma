// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../web/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Battlefield {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  titleIncludes   String[]
  titleExcludes   String[]
  locations       String[]
  // extra location chips added with "+ New Location" on the Battlefield's search bar
  customLocations String[]  @default([])
  maxBoards       Int       @default(2000)
  maxJobs         Int       @default(200)
  maxJobsPerBoard Int       @default(25)
  autoPopulate    Boolean   @default(false)
  autoRank        Boolean   @default(false)
  archived        Boolean   @default(false)
  // when the user last opened this Battlefield's Discovery; jobs first seen
  // after it are "new" on the homepage
  lastViewedAt    DateTime?
  // when the scheduled Auto-Populate last started a search for it
  lastAutoRunAt   DateTime?
  createdAt       DateTime  @default(now())
  jobs            Job[]
  rubrics         Rubric[]
  runs            Run[]
  resumes         Resume[]
  notes           Note[]
}

model Job {
  id            String       @id @default(cuid())
  atsJobId      String
  // null for jobs that only live in an Explore search wave
  battlefield   Battlefield? @relation(fields: [battlefieldId], references: [id])
  battlefieldId String?
  searchWave    SearchWave?  @relation(fields: [searchWaveId], references: [id])
  searchWaveId  String?
  source        String
  company       String
  title         String
  location      String?
  locationBin   String?
  url           String
  description   String?
  firstSeen     DateTime     @default(now())
  lastSeenAt    DateTime     @default(now())
  closed        Boolean      @default(false)
  closedAt      DateTime?
  dismissed     Boolean      @default(false)
  raw           Json?
  judgments     Judgment[]
  application   Application?
  statusNotes   StatusNote[]

  @@unique([battlefieldId, atsJobId])
}

model Rubric {
  id            String      @id @default(cuid())
  battlefield   Battlefield @relation(fields: [battlefieldId], references: [id])
  battlefieldId String
  version       Int
  active        Boolean     @default(false)
  body          String
  createdAt     DateTime    @default(now())
  judgments     Judgment[]
}

model Judgment {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  rubric    Rubric   @relation(fields: [rubricId], references: [id])
  rubricId  String
  grade     String
  score     Int
  reason    String
  keyGap    String?
  createdAt DateTime @default(now())

  @@unique([jobId, rubricId])
}

model Application {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String   @unique
  status    String   @default("interested")
  notes     String?
  updatedAt DateTime @updatedAt
}

model StatusNote {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  stage     String
  note      String
  createdAt DateTime @default(now())

  @@unique([jobId, stage])
}

model SearchWave {
  id        String   @id @default(cuid())
  query     String
  locations String[]
  createdAt DateTime @default(now())
  jobCount  Int      @default(0)
  jobs      Job[]
  runs      Run[]
}

model Run {
  id            String       @id @default(cuid())
  battlefield   Battlefield? @relation(fields: [battlefieldId], references: [id])
  battlefieldId String?
  // set on Explore searches: the wave the results are saved into
  searchWave    SearchWave?  @relation(fields: [searchWaveId], references: [id])
  searchWaveId  String?
  // one Apify run per location; the status route checks them and ingests when done
  apifyRunIds   String[]
  kind          String // "search" | "rank"
  status        String       @default("running") // running | ingesting | done | failed
  // stamped every few seconds while ingesting; a stale stamp means the saver died
  heartbeatAt   DateTime?
  jobsFound     Int          @default(0)
  jobsNew       Int          @default(0)
  jobsRanked    Int          @default(0)
  error         String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
}

// A resume the user keeps for a track (a Battlefield, or any track when null).
model Resume {
  id            String          @id @default(cuid())
  name          String
  battlefield   Battlefield?    @relation(fields: [battlefieldId], references: [id], onDelete: SetNull)
  battlefieldId String?
  createdAt     DateTime        @default(now())
  versions      ResumeVersion[]
}

// Version A, B, C... of a resume, with notes on what makes it different.
model ResumeVersion {
  id        String       @id @default(cuid())
  resume    Resume       @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId  String
  label     String
  notes     String       @default("")
  createdAt DateTime     @default(now())
  files     ResumeFile[]

  @@unique([resumeId, label])
}

// One uploaded file per version and format ("pdf" or "docx"). The bytes live in
// the database because Railway's disk does not survive a redeploy.
model ResumeFile {
  id         String        @id @default(cuid())
  version    ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId  String
  kind       String
  fileName   String
  size       Int
  data       Bytes
  uploadedAt DateTime      @default(now())

  @@unique([versionId, kind])
}

// Small app-wide settings, e.g. the Resumes password hash and cookie signing key.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A free-form note, optionally filed under a Battlefield.
model Note {
  id            String       @id @default(cuid())
  title         String       @default("")
  body          String       @default("")
  pinned        Boolean      @default(false)
  battlefield   Battlefield? @relation(fields: [battlefieldId], references: [id], onDelete: SetNull)
  battlefieldId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([updatedAt])
}
