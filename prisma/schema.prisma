// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../web/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Battlefield {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  titleIncludes   String[]
  titleExcludes   String[]
  locations       String[]
  maxBoards       Int      @default(2000)
  maxJobs         Int      @default(200)
  maxJobsPerBoard Int      @default(25)
  autoPopulate    Boolean  @default(false)
  autoRank        Boolean  @default(false)
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())
  jobs            Job[]
  rubrics         Rubric[]
  runs            Run[]
}

model Job {
  id            String       @id @default(cuid())
  atsJobId      String
  // null for jobs that only live in an Explore search wave
  battlefield   Battlefield? @relation(fields: [battlefieldId], references: [id])
  battlefieldId String?
  searchWave    SearchWave?  @relation(fields: [searchWaveId], references: [id])
  searchWaveId  String?
  source        String
  company       String
  title         String
  location      String?
  locationBin   String?
  url           String
  description   String?
  firstSeen     DateTime     @default(now())
  lastSeenAt    DateTime     @default(now())
  closed        Boolean      @default(false)
  closedAt      DateTime?
  dismissed     Boolean      @default(false)
  raw           Json?
  judgments     Judgment[]
  application   Application?
  statusNotes   StatusNote[]

  @@unique([battlefieldId, atsJobId])
}

model Rubric {
  id            String      @id @default(cuid())
  battlefield   Battlefield @relation(fields: [battlefieldId], references: [id])
  battlefieldId String
  version       Int
  active        Boolean     @default(false)
  body          String
  createdAt     DateTime    @default(now())
  judgments     Judgment[]
}

model Judgment {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  rubric    Rubric   @relation(fields: [rubricId], references: [id])
  rubricId  String
  grade     String
  score     Int
  reason    String
  keyGap    String?
  createdAt DateTime @default(now())

  @@unique([jobId, rubricId])
}

model Application {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String   @unique
  status    String   @default("interested")
  notes     String?
  updatedAt DateTime @updatedAt
}

model StatusNote {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  stage     String
  note      String
  createdAt DateTime @default(now())

  @@unique([jobId, stage])
}

model SearchWave {
  id        String   @id @default(cuid())
  query     String
  locations String[]
  createdAt DateTime @default(now())
  jobCount  Int      @default(0)
  jobs      Job[]
  runs      Run[]
}

model Run {
  id            String       @id @default(cuid())
  battlefield   Battlefield? @relation(fields: [battlefieldId], references: [id])
  battlefieldId String?
  // set on Explore searches: the wave the results are saved into
  searchWave    SearchWave?  @relation(fields: [searchWaveId], references: [id])
  searchWaveId  String?
  // one Apify run per location; the status route checks them and ingests when done
  apifyRunIds   String[]
  kind          String // "search" | "rank"
  status        String       @default("running") // running | ingesting | done | failed
  jobsFound     Int          @default(0)
  jobsNew       Int          @default(0)
  jobsRanked    Int          @default(0)
  error         String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
}
